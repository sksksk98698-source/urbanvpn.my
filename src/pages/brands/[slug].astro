---
import NetworkTopology from "@components/observatory/NetworkTopology.astro";
import SpeedtestDashboard from "@components/observatory/SpeedtestDashboard.astro";
import StreamingUnlockMatrix from "@components/observatory/StreamingUnlockMatrix.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteUrl } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { type Airport, airports } from "@/data/airports";

export async function getStaticPaths() {
	return airports.map((airport) => ({
		params: { slug: airport.id },
		props: { airport },
	}));
}

interface Props {
	airport: Airport;
}

const { airport } = Astro.props;

const pageTitle = `${airport.name}怎么样？2026 深度评测、晚高峰测速、套餐与优惠码`;
const pageDescription = `${airport.name}实测评测：起步价格${airport.entryPrice}${airport.pricePeriod}，采用${airport.lineType}，协议支持${airport.protocols.join(" / ")}。提供最新晚高峰节点延迟、流媒体与ChatGPT解锁实测数据。`;

const canonicalUrl = siteUrl(`brands/${airport.id}/`);

// Schema.org Structured Data
const breadcrumbLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "首页",
			item: siteUrl(),
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "机场品牌库",
			item: siteUrl("brands/"),
		},
		{
			"@type": "ListItem",
			position: 3,
			name: airport.name,
			item: canonicalUrl,
		},
	],
};

const productLd = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: airport.name,
	description: airport.description,
	brand: {
		"@type": "Brand",
		name: airport.name,
	},
	offers: {
		"@type": "Offer",
		price: airport.entryPrice,
		priceCurrency: "CNY",
		availability: "https://schema.org/InStock",
		url: airport.affUrl,
	},
	review: {
		"@type": "Review",
		reviewRating: {
			"@type": "Rating",
			ratingValue:
				airport.rank === 1
					? "4.9"
					: airport.rank <= 3
						? "4.8"
						: airport.rank <= 10
							? "4.7"
							: "4.5",
			bestRating: "5",
		},
		author: {
			"@type": "Organization",
			name: "urbanVPN",
			url: siteUrl(),
		},
		datePublished: airport.verifiedDate,
	},
};

const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: [
		{
			"@type": "Question",
			name: `${airport.name} 支持哪些客户端？新手如何导入？`,
			acceptedAnswer: {
				"@type": "Answer",
				text: `${airport.name} ${airport.clientSupport}。支持一键导入主流客户端如 Clash Verge Rev、Shadowrocket、v2rayN、Stash 与 FlClash。`,
			},
		},
		{
			"@type": "Question",
			name: `${airport.name} 能够稳定解锁 Netflix 与 ChatGPT 吗？`,
			acceptedAnswer: {
				"@type": "Answer",
				text: `根据我们对 ${airport.name} 的节点测试，流媒体与AI工具的解锁状态为：Netflix: ${airport.unlockStatus.netflix}，ChatGPT: ${airport.unlockStatus.chatgpt}。建议优先选用香港、日本或新加坡原生落地节点。`,
			},
		},
		{
			"@type": "Question",
			name: `${airport.name} 的优惠码是什么？如何使用？`,
			acceptedAnswer: {
				"@type": "Answer",
				text: airport.coupon
					? `${airport.name} 目前提供官方有效专属优惠码【${airport.coupon}】，在结账结算页面输入该代码即可享受优惠折减。`
					: `${airport.name} 目前主要以直接套餐折扣呈现，建议按需先选购月付小额套餐体验。`,
			},
		},
	],
};
---

<MainGridLayout title={pageTitle} description={pageDescription} lang="zh-CN">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(productLd)}></script>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

  <div class="space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-neutral-400 font-medium">
      <a href="/" class="hover:text-(--primary) transition">首页</a>
      <span>/</span>
      <a href="/brands/" class="hover:text-(--primary) transition">机场品牌库</a>
      <span>/</span>
      <span class="text-neutral-700 dark:text-neutral-200">{airport.name}</span>
    </nav>

    <!-- Main Profile Card Header -->
    <div class="card-base p-6 md:p-8 rounded-2xl relative overflow-hidden">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 flex-1">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="text-xs px-2.5 py-0.5 rounded-full font-bold bg-(--primary) text-white font-mono">
              综合排名 TOP {airport.rank}
            </span>
            <span class="text-xs px-2.5 py-0.5 rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 font-medium">
              {airport.lineType}
            </span>
            <span class="text-xs px-2.5 py-0.5 rounded bg-slate-500/10 text-slate-500 border border-slate-500/20 font-mono">
              {airport.established}
            </span>
            {airport.isMainPush && (
              <span class="text-xs px-2.5 py-0.5 rounded bg-rose-500/10 text-rose-500 border border-rose-500/30 font-bold">
                ★ 2026 年度主推
              </span>
            )}
          </div>

          <h1 class="text-2xl md:text-3xl font-extrabold text-neutral-900 dark:text-neutral-50 tracking-tight">
            {airport.name} ({airport.englishName}) 综合深度评测
          </h1>

          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-3xl">
            {airport.description}
          </p>

          <div class="flex flex-wrap items-center gap-4 text-xs font-mono pt-2">
            <div class="flex items-center gap-1.5 bg-black/5 dark:bg-white/5 px-3 py-1.5 rounded-xl">
              <span class="text-neutral-400">起步费用:</span>
              <strong class="text-(--primary) text-sm">¥{airport.entryPrice}</strong>
              <span class="text-neutral-500">({airport.pricePeriod})</span>
            </div>
            {airport.coupon && (
              <div class="flex items-center gap-1.5 bg-(--primary)/10 border border-(--primary)/20 px-3 py-1.5 rounded-xl">
                <span class="text-neutral-400">专属优惠码:</span>
                <strong class="text-(--primary) text-sm font-bold">{airport.coupon}</strong>
              </div>
            )}
            <div class="flex items-center gap-1.5 bg-black/5 dark:bg-white/5 px-3 py-1.5 rounded-xl text-neutral-500">
              <span>核验时间:</span>
              <span>{airport.verifiedDate}</span>
            </div>
          </div>
        </div>

        <!-- CTA Box -->
        <div class="flex flex-col gap-3 w-full md:w-56 flex-shrink-0">
          <a
            href={airport.affUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="py-3 px-5 text-center text-sm font-bold rounded-xl bg-(--primary) hover:opacity-95 text-white transition active:scale-95 shadow-lg shadow-(--primary)/25 flex items-center justify-center gap-2"
          >
            官网注册直达
            <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs" />
          </a>
          <span class="text-[11px] text-center text-neutral-400 leading-tight">
            * 推广赞助通道，通过本链接注册不增加购买费用，享本站技术背书保障。
          </span>
        </div>
      </div>
    </div>

    <!-- GEO Answer-First: 核心评估摘要 -->
    <div class="card-base p-6 rounded-2xl space-y-4">
      <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-50 flex items-center gap-2">
        <Icon name="material-symbols:article-outline" class="text-(--primary) text-xl" />
        {airport.name} 核心评估与决策建议
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- 适合人群 -->
        <div class="bg-emerald-500/5 border border-emerald-500/20 rounded-xl p-4">
          <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5 mb-2.5">
            <Icon name="material-symbols:check-circle-outline" class="text-base" />
            推荐选购人群（适合谁）
          </div>
          <ul class="text-xs text-neutral-600 dark:text-neutral-300 space-y-1.5">
            {airport.suitableFor.map((s) => (
              <li class="flex items-start gap-1.5">
                <span class="text-emerald-500 font-bold">•</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- 限制与注意事项 -->
        <div class="bg-amber-500/5 border border-amber-500/20 rounded-xl p-4">
          <div class="text-xs font-bold text-amber-600 dark:text-amber-400 flex items-center gap-1.5 mb-2.5">
            <Icon name="material-symbols:warning-outline" class="text-base" />
            客观限制与注意事项（避坑提示）
          </div>
          <ul class="text-xs text-neutral-600 dark:text-neutral-300 space-y-1.5">
            {airport.limitations.map((l) => (
              <li class="flex items-start gap-1.5">
                <span class="text-amber-500 font-bold">•</span>
                <span>{l}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- 专线网络拓扑 -->
    <NetworkTopology brandName={airport.name} lineType={airport.lineType} protocols={airport.protocols} />

    <!-- 测速面板 (Dark Network Observatory) -->
    <SpeedtestDashboard
      brandName={airport.name}
      items={airport.speedtest || []}
      speedtestImage={airport.speedtestImage}
      testedAt={airport.verifiedDate}
    />

    <!-- AI 与流媒体解锁矩阵 -->
    <StreamingUnlockMatrix
      brandName={airport.name}
      unlock={airport.unlockStatus}
      unlockImages={airport.unlockImages}
    />

    <!-- 套餐价格表 -->
    <div class="card-base p-6 rounded-2xl space-y-4">
      <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-50 flex items-center gap-2">
        <Icon name="material-symbols:payments-outline" class="text-(--primary) text-xl" />
        {airport.name} 详细套餐资费与规格
      </h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-black/5 dark:bg-white/5 border-b border-black/10 dark:border-white/10 text-neutral-500 dark:text-neutral-400">
            <tr>
              <th class="py-3 px-4 font-semibold">套餐名称</th>
              <th class="py-3 px-4 font-semibold">价格</th>
              <th class="py-3 px-4 font-semibold">流量额度</th>
              <th class="py-3 px-4 font-semibold">付费周期与说明</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-black/5 dark:divide-white/5">
            {airport.plans.map((p) => (
              <tr class="hover:bg-black/5 dark:hover:bg-white/5 transition">
                <td class="py-3 px-4 font-bold text-neutral-900 dark:text-neutral-100">{p.name}</td>
                <td class="py-3 px-4 text-(--primary) font-bold text-sm">{p.price}</td>
                <td class="py-3 px-4 font-medium">{p.traffic}</td>
                <td class="py-3 px-4 text-neutral-500 dark:text-neutral-400">{p.period}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-neutral-400 font-sans">
        * 资费数据基于品牌公示信息整理，具体价格与优惠活动以服务商官网结算页面为准。
      </p>
    </div>

    <!-- 客户端支持与导入指南 -->
    <div class="card-base p-6 rounded-2xl space-y-3">
      <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-50 flex items-center gap-2">
        <Icon name="material-symbols:devices-outline" class="text-(--primary) text-xl" />
        客户端兼容性与导入使用指南
      </h2>
      <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
        {airport.clientSupport}。支持 Windows（Clash Verge Rev, v2rayN）、macOS（Clash Verge, Surge）、iOS（Shadowrocket 小火箭, Stash）、Android（v2rayNG, FlClash）及 OpenWrt 软路由。
      </p>
      <div class="pt-2">
        <a href="/clients/" class="text-xs font-bold text-(--primary) hover:underline inline-flex items-center gap-1">
          查看 2026 全平台第三方代理客户端下载与通用配置教程 →
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="card-base p-6 rounded-2xl space-y-4">
      <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-50 flex items-center gap-2">
        <Icon name="material-symbols:help-outline" class="text-(--primary) text-xl" />
        关于 {airport.name} 的常见问题解答 (FAQ)
      </h2>
      <div class="space-y-3 text-xs md:text-sm">
        <div class="bg-black/5 dark:bg-white/5 p-4 rounded-xl space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-100">
            Q1: {airport.name} 支持哪些客户端？新手如何导入？
          </h3>
          <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
            {airport.name} {airport.clientSupport}。新手登录后台复制通用订阅，粘贴至客户端的订阅管理中更新即可使用。
          </p>
        </div>

        <div class="bg-black/5 dark:bg-white/5 p-4 rounded-xl space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-100">
            Q2: {airport.name} 晚高峰网络会卡顿吗？
          </h3>
          <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
            该机场采用 {airport.lineType}。在实测中，亚太近端主流节点表现优异。但遇到重大促销或公网波动时，建议切换不同区域备份节点以获得最佳体验。
          </p>
        </div>

        <div class="bg-black/5 dark:bg-white/5 p-4 rounded-xl space-y-1">
          <h3 class="font-bold text-neutral-900 dark:text-neutral-100">
            Q3: {airport.name} 的优惠码是多少？
          </h3>
          <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed">
            {airport.coupon ? `官方专属优惠码为【${airport.coupon}】，在订单结账页面输入即可抵扣。` : '目前官方主要直接在套餐中提供周期折扣，建议先选择月付进行体验。'}
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Action Bar -->
    <div class="card-base p-6 rounded-2xl flex flex-wrap items-center justify-between gap-4 border border-(--primary)/20">
      <div>
        <div class="font-bold text-neutral-900 dark:text-neutral-100 text-sm">
          对 {airport.name} 感兴趣？立即前往官方网站体验
        </div>
        <div class="text-xs text-neutral-400">
          起步资费约 ¥{airport.entryPrice}{airport.pricePeriod} · 专属优惠码: {airport.coupon || '官网直享'}
        </div>
      </div>
      <a
        href={airport.affUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="py-2.5 px-6 rounded-xl bg-(--primary) text-white font-bold text-xs hover:opacity-95 transition shadow-lg shadow-(--primary)/20 flex items-center gap-1.5"
      >
        官网注册直达 ↗
      </a>
    </div>
  </div>
</MainGridLayout>
