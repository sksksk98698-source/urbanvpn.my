---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "../../components/control/Pagination.astro";
import PostPage from "../../components/PostPage.astro";
import {
	DEFAULT_LANG,
	PAGE_SIZE,
	SUPPORTED_LANG,
} from "../../constants/constants";
import { airports } from "../../data/airports";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allPaths = [];

	for (const lang of SUPPORTED_LANG) {
		const postsForLang = await getSortedPosts(lang);
		const langParam = lang === DEFAULT_LANG ? undefined : lang;

		const paginatedPages = paginate(postsForLang, {
			params: { lang: langParam },
			pageSize: PAGE_SIZE,
			props: { lang },
		});

		allPaths.push(...paginatedPages);
	}

	return allPaths;
}) satisfies GetStaticPaths;

const { page, lang } = Astro.props;
const len = page.data.length;

const mainPush = airports.find((a) => a.isMainPush) || airports[0];
---

<MainGridLayout lang={lang}>
    <h1 class="sr-only">urbanVPN · 42 家主流机场深度测评与网络可观测性评测中心</h1>
    {page.currentPage === 1 && (
        <div class="card-base p-6 rounded-2xl mb-4 border border-(--primary)/20 relative overflow-hidden">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="space-y-1.5 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="text-xs px-2.5 py-0.5 rounded-full bg-amber-500 text-slate-950 font-black">
                            TOP 1 主推
                        </span>
                        <span class="text-xs font-bold text-neutral-900 dark:text-neutral-100">
                            {mainPush.name} · {mainPush.lineType}
                        </span>
                        <span class="text-xs text-(--primary) font-mono font-bold">
                            券码: {mainPush.coupon}
                        </span>
                    </div>
                    <p class="text-xs text-neutral-600 dark:text-neutral-300">
                        2020年稳定运营，年付折算仅约 8 元/月，独家致敬斯诺克 147 永久套餐（247GB不过期），不限设备同时在线。
                    </p>
                </div>
                <div class="flex items-center gap-2 w-full md:w-auto">
                    <a href="/brands/" class="btn-regular py-2 px-3 text-xs font-bold rounded-lg transition flex-1 md:flex-initial text-center whitespace-nowrap">
                        42家品牌库
                    </a>
                    <a href={mainPush.affUrl} target="_blank" rel="nofollow sponsored noopener" class="py-2 px-4 text-xs font-bold rounded-lg bg-(--primary) text-white hover:opacity-95 transition flex items-center justify-center gap-1 flex-1 md:flex-initial whitespace-nowrap shadow-md shadow-(--primary)/20">
                        官网注册直达 ↗
                    </a>
                </div>
            </div>

            <!-- Fast navigation badges -->
            <div class="mt-4 pt-3 border-t border-black/5 dark:border-white/10 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-neutral-400 font-medium">快速进入:</span>
                <a href="/brands/" class="px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition font-medium flex items-center gap-1">
                    <Icon name="material-symbols:database-outline" class="text-sm" />
                    42家机场品牌库
                </a>
                <a href="/reviews/" class="px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition font-medium flex items-center gap-1">
                    <Icon name="material-symbols:speed-outline" class="text-sm" />
                    17家晚高峰实测中心
                </a>
                <a href="/clients/" class="px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition font-medium flex items-center gap-1">
                    <Icon name="material-symbols:devices-outline" class="text-sm" />
                    全平台客户端配置
                </a>
                <a href="/topics/" class="px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/5 hover:text-(--primary) transition font-medium flex items-center gap-1">
                    <Icon name="material-symbols:school-outline" class="text-sm" />
                    IEPL与IPLC专线科普
                </a>
            </div>
        </div>
    )}

    <PostPage page={page} lang={lang}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
