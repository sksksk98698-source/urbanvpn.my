---
import { getCollection } from "astro:content";
import { siteUrl } from "@utils/url-utils";
import { profileConfig, siteConfig, verificationConfig } from "@/config";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	setOGTypeArticle?: boolean;
	lang?: string;
}

let {
	title,
	description = siteConfig.subtitle,
	image,
	setOGTypeArticle = false,
	lang = siteConfig.lang,
} = Astro.props;

let pageTitle: string;
if (title) {
	pageTitle = `${title} | ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

// 确保 canonical 为标准 HTTPS 绝对路径，且遵从尾斜杠策略
let cleanPath = Astro.url.pathname;
if (!cleanPath.endsWith("/") && !cleanPath.includes(".")) {
	cleanPath += "/";
}
const canonicalUrl = new URL(cleanPath, siteUrl()).href;
const slug = Astro.url.pathname.split("/").filter(Boolean).pop();

interface PageData {
	published?: Date | string;
	updated?: Date | string;
	tags?: string[];
	description?: string;
}

let pageData: PageData = {};
try {
	const allEntries = await getCollection("posts");
	const entry = allEntries.find((e) => e.id === slug);
	if (entry) {
		pageData = entry.data as PageData;
	}
} catch (e) {
	// silent fail if no blog/post page
}

let ogImage: string | undefined;
const defaultOgImage = siteConfig.ogImage.useDefault
	? siteUrl(siteConfig.ogImage.defaultSrc)
	: undefined;

ogImage = defaultOgImage;

if (image && typeof image === "string" && image.trim() !== "") {
	if (image.startsWith("http://") || image.startsWith("https://")) {
		ogImage = image;
	} else if (
		image.startsWith("/media") ||
		image.startsWith("media") ||
		image.startsWith("/")
	) {
		ogImage = siteUrl(image);
	} else {
		ogImage = defaultOgImage;
	}
}

const formatDate = (date: Date | string | undefined): string | null => {
	if (!date) return null;
	if (date instanceof Date) return date.toISOString().split("T")[0];
	if (typeof date === "string") return date.split("T")[0];
	return null;
};

const publishedDate = formatDate(pageData.published);
const updatedDate = formatDate(pageData.updated);
const tags: string[] = pageData.tags || [];

if (!description) {
	description = pageData.description || pageTitle;
}

// 全站基础 Schema：WebSite + Organization
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteConfig.title,
	url: siteUrl(),
	description: siteConfig.subtitle,
	inLanguage: lang.replace("_", "-"),
};

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: siteConfig.title,
	url: siteUrl(),
	logo: siteUrl("assets/images/avatar.svg"),
	description: siteConfig.subtitle,
	sameAs: [
		siteUrl("/brands/"),
		siteUrl("/reviews/"),
		siteUrl("/topics/"),
		siteUrl("/warnings/"),
	],
};

const siteSchemas = [websiteSchema, organizationSchema];
---

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content={profileConfig.name} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={canonicalUrl} />

<!-- 搜索引擎站长平台安全验证预留 (Google, Bing, 百度, 神马) -->
{verificationConfig.google && <meta name="google-site-verification" content={verificationConfig.google} />}
{verificationConfig.bing && <meta name="msvalidate.01" content={verificationConfig.bing} />}
{verificationConfig.baidu && <meta name="baidu-site-verification" content={verificationConfig.baidu} />}
{verificationConfig.shenma && <meta name="shenma-site-verification" content={verificationConfig.shenma} />}

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={lang.replace("_", "-")} />
{ogImage && <meta property="og:image" content={ogImage} />}

{setOGTypeArticle ? (
  <>
    <meta property="og:type" content="article" />
    {tags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate} />}
  </>
  ) : (
  <meta property="og:type" content="website" />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!-- Structured Data -->
{!setOGTypeArticle && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchemas)} />
)}
